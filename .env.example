# ResourceHub environment configuration
# Copy this file to .env for local development.

# REQUIRED for production: generate a long random value.
SECRET_KEY=replace-with-a-long-random-secret

# Optional. Defaults to SQLite at instance/resource_allocation.db.
# For PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/resourcehub

# Local development only. Keep this disabled in production.
FLASK_DEBUG=0
